rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function runFields(d) {
      return d.keys().hasAll(['uid', 'startedAt', 'finished', 'score'])
        && d.keys().hasOnly(['uid', 'startedAt', 'finished', 'score']);
    }
    function startRun() {
      let d = request.resource.data;
      return signedIn() && runFields(d) && d.uid == request.auth.uid
        && d.startedAt is timestamp && d.startedAt == request.time && d.finished == false
        && d.score is int && d.score == 0;
    }
    function finishRun(cap, rate) {
      let d = request.resource.data;
      let elapsed = request.time - resource.data.startedAt;
      return signedIn() && resource.data.uid == request.auth.uid
        && runFields(d) && resource.data.finished == false && d.finished == true
        && d.diff(resource.data).affectedKeys().hasOnly(['finished', 'score'])
        && d.uid == resource.data.uid && d.startedAt == resource.data.startedAt
        && request.time >= resource.data.startedAt
        && d.score is int && d.score >= 0 && d.score <= cap
        && d.score <= (elapsed.seconds() + elapsed.nanos() / 1000000000.0) * rate;
    }
    function validScore(uid, runs) {
      let d = request.resource.data;
      let path = /databases/$(database)/documents/$(runs)/$(d.runId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return signedIn() && uid == request.auth.uid
        && d.keys().hasAll(['name', 'score', 'runId', 'updatedAt'])
        && d.keys().hasOnly(['name', 'score', 'runId', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.runId is string && d.runId.matches('^[A-Za-z0-9_-]{1,128}$')
        && d.score is int && d.score >= 0 && d.updatedAt == request.time
        && before.uid == uid && before.finished == false
        && after.uid == uid && after.finished == true && after.score == d.score;
    }
    match /runs_cat/{runId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if startRun();
      allow update: if finishRun(100000, 6);
    }
    match /runs_pacman/{runId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if startRun();
      allow update: if finishRun(10000000, 2000);
    }
    match /scores_cat/{uid} {
      allow read: if true;
      allow create: if validScore(uid, 'runs_cat');
      allow update: if validScore(uid, 'runs_cat') && request.resource.data.score >= resource.data.score;
    }
    match /scores_pacman/{uid} {
      allow read: if true;
      allow create: if validScore(uid, 'runs_pacman');
      allow update: if validScore(uid, 'runs_pacman') && request.resource.data.score >= resource.data.score;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
