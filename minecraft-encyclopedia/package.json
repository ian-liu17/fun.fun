{
    "name":  "mine-illustrated-encyclopedia",
    "version":  "1.0.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev --hostname 127.0.0.1",
                    "data":  "node scripts/build-data.mjs \u0026\u0026 node scripts/complete-exports.mjs",
                    "build":  "npm run data \u0026\u0026 node scripts/prepare-game.mjs \u0026\u0026 next build \u0026\u0026 node scripts/export-offline.mjs",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint .",
                    "test":  "node --test tests/*.test.mjs",
                    "test:browser":  "node scripts/browser-test.mjs",
                    "test:skill":  "node scripts/test-skill.mjs",
                    "play":  "node scripts/serve-mine.mjs"
                },
    "dependencies":  {
                         "next":  "15.5.12",
                         "react":  "19.1.4",
                         "react-dom":  "19.1.4"
                     },
    "devDependencies":  {
                            "@axe-core/playwright":  "^4.10.0",
                            "@playwright/test":  "^1.56.0",
                            "@tailwindcss/postcss":  "^4.1.0",
                            "@types/node":  "^22.15.0",
                            "@types/react":  "^19.1.0",
                            "@types/react-dom":  "^19.1.0",
                            "esbuild":  "^0.28.2",
                            "eslint":  "^9.0.0",
                            "eslint-config-next":  "15.5.12",
                            "tailwindcss":  "^4.1.0",
                            "typescript":  "^5.8.0"
                        }
}
